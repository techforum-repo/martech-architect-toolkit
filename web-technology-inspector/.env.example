# =========================================================
# Web Technology Inspector
# Environment Configuration
#
# Every line maps to a field in web_inspector/config.py's Settings class.
# AEM environments and website mappings are managed on the Settings page.
# =========================================================

APP_ENV=development

# true  = sample scan and sample AEM data; nothing is loaded from the web or AEM.
# false = real browser scans and live AEM lookups. Also switchable in the sidebar.
MOCK_MODE=true

# -----------------------------
# Browser scan
# -----------------------------
# Seconds allowed for a page to load before the scan gives up.
SCAN_TIMEOUT=45

# Seconds to wait for network activity to settle after load, after scrolling
# and after accepting consent. Tags that fire later are not captured.
SETTLE_SECONDS=6

# true = open a visible browser window by default. Sites behind bot protection
# often block the hidden (headless) browser.
SHOW_BROWSER=false

# -----------------------------
# Local data
# -----------------------------
# Folder for the scan history database (relative to this folder unless absolute).
DATA_DIR=data

# Port the start scripts try first (8502, so it can run beside the Groovy Runner).
WEB_INSPECTOR_PORT=8502

# There are no credentials here on purpose. AEM tokens are entered on the
# Settings page and kept in session memory or encrypted local storage.
