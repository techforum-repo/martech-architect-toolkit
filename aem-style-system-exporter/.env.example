
# Readable name for this environment, e.g. prod (used in folder listings and workbook names)
AEM_ENV_NAME=

AEM_AUTHOR_URL=https://author-pXXXXX-eXXXXX.adobeaemcloud.com
AEM_LOCAL_TOKEN=
AEM_POLICY_ROOT=/conf/ewp/settings/wcm/policies
AEM_TEMPLATE_ROOT=/conf/ewp/settings/wcm/templates

MAX_DEPTH=30
MAX_NODES=15000
# Levels fetched per request (Sling .N.json); falls back to 1 if AEM answers 300
FETCH_DEPTH=3
# Parallel requests to AEM Author
CONCURRENCY=4
REQUEST_TIMEOUT=30000
PROGRESS_INTERVAL=25

FE_PROJECT_PATH=
FE_THEMES=corporate
FE_BUILD=false
FE_BUILD_COMMAND=npm run build
FE_SHARED_CSS=

# Exports kept per environment in output/history, for the Changes sheet and npm run compare
HISTORY_KEEP=20

# First port tried by the compare page (compare.bat / compare.sh)
COMPARE_UI_PORT=8510

# Where environments, runs and comparisons are kept; default output/.
# A shared folder (e.g. a network drive) lets a team see each other's runs.
HISTORY_DIR=

# Keep the large front-end data files (fe-data.json, style-css-mapping.json) in each run
KEEP_RAW_DATA=false
